# Shared defaults. CSDK_PUBLIC_ prefixed variables are exposed to the client side and processed by `npm run gen:env:dev` and `npm run gen:env:prod`.
# Copy to `.env` and fill in. Do not commit `.env`.

# Edge API
# SITECORE_EDGE_CONTEXT_ID=
# CSDK_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
# CSDK_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=
# SITECORE_EXPERIENCE_EDGE_HOSTNAME=

# Local API (non-Edge)
# CSDK_PUBLIC_SITECORE_API_KEY=
# CSDK_PUBLIC_SITECORE_API_HOST=

# On-demand revalidation (`POST /api/revalidate`). Leave empty to skip auth (no `x-revalidate-secret` header).
# When set, webhook/callers must send the same value in the `x-revalidate-secret` header.
# SITECORE_REVALIDATE_SECRET=

# Site / language
# CSDK_PUBLIC_SITECORE_DEFAULT_SITE=
# CSDK_PUBLIC_SITECORE_DEFAULT_LANGUAGE=en

# Global switch for Content SDK experimental features. Set to `true`
# together with individual `CSDK_EXPERIMENTAL_*` flags during development.
# CSDK_GLOBAL_EXPERIMENTAL_FEATURES_ENABLED=false

# Timeout (ms) for Sitecore CDP requests to respond within. Default is 400.
# PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=

# Timeout (ms) for Sitecore Experience Edge requests to respond within. Default is 400.
# PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=
